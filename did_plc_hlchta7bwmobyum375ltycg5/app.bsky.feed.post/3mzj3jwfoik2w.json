      "embed": {
        "$type": "app.bsky.embed.video",
        "alt": "#requires -Module Wave, RoughDraft\n\n<#\n.SYNOPSIS\n    Ode to Joy\n.DESCRIPTION\n    Beethoven's Ode to Joy, from Symphony #9\n.LINK\n    https://en.wikipedia.org/wiki/Symphony_No._9_(Beethoven)\n#>\n\n# Score\n\n$ode = @(\n\n    \"E E F G\"\n    \"G F E D\"\n    \"C C D E\"\n    \"E@1.5 D:2 D:2 ~\"\n\n    \"E E F G\"\n    \"G F E D\"\n    \"C C D E\"\n    \"D@1.5 C:2 C:2 ~\"\n\n    \"D D E C\"\n\n    \"D E:2 F:2 E C\"\n\n    \"D E:2 F:2 E D\"\n\n    \"C D G@2\"\n\n    \"E E F G\"\n    \"G F E D\"\n    \"C C D E\"\n\n    \"D C:2 C:2\"\n)\n\n# Make waves\n\n$odeToJoy = wave volume 0.2026 chords 1, 2, 0.5, 0.25 weights (1,1,1,1)  note $ode\n\n# Visuals\n\n$odeToJoy | \n    wave save ./OdeToJoy.wav |\n    Convert-Media -OutputPath ./OdeToJoy.mp3 |\n    Edit-Media -ShowWaveForm -OutputPath ./OdeToJoy.mp4",
